---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Icon from '../../../components/Icon.astro';
import { languages, t, type Lang, base } from '../../../i18n/ui';
import { subjects, groupKey, type Subject } from '../../../lib/subjects';

export function getStaticPaths() {
  return Object.keys(languages).flatMap((lang) => Object.keys(subjects).map((subject) => ({ params: { lang, subject } })));
}
const lang = Astro.params.lang as Lang;
const subject = Astro.params.subject as Subject;
const tr = t(lang);
const glossary = (await getCollection('glossary')).filter((g) => g.data.subject === subject);
const tasks = (await getCollection('tasks'))
  .filter((x) => x.data.subject === subject)
  .sort((a, b) => a.data.level - b.data.level || a.id.localeCompare(b.id));
const groups = subjects[subject]
  .map((id) => ({ id, title: tr[groupKey(id) as keyof typeof tr] ?? id, tasks: tasks.filter((x) => x.data.group === id) }))
  .filter((g) => g.tasks.length);
---
<Layout lang={lang} title={tr[subject]}>
  <h1><Icon name={subject} /> {tr[subject]}</h1>

  <h2>{tr.glossary}</h2>
  <div class="grid">
    {glossary.map((g) => (
      <a class="card" href={`${base}/${lang}/glossary/${g.id}/`}>
        <strong>{g.data.title[lang]}</strong>
        <div class="note">{g.data.terms.length} · {tr.flashcards.toLowerCase()}</div>
      </a>
    ))}
  </div>

  <h2>{tr.tasks}</h2>
  {groups.map((g) => (
    <>
      <h3>{g.title}</h3>
      <div class="grid">
        {g.tasks.map((x, i) => (
          <a class="card" href={`${base}/${lang}/tasks/${x.id}/`} data-task={x.id}>
            <strong>{tr.task} {i + 1}</strong>
            <span class="badge badge--done" data-solved hidden><Icon name="check" /> {tr.solved}</span>
            <div class="note">{x.data.grade} {tr.grade} · {tr.level} {x.data.level}</div>
            <div lang="lt">{x.data.lt.slice(0, 90)}…</div>
          </a>
        ))}
      </div>
    </>
  ))}
  <script is:inline>
    // Marks tasks solved in this browser (set by TaskCheck). Works without storage too.
    document.querySelectorAll('[data-task]').forEach(function (card) {
      try {
        if (localStorage.getItem('tiltas:solved:' + card.getAttribute('data-task'))) {
          card.querySelector('[data-solved]').hidden = false;
        }
      } catch (e) {}
    });
  </script>
</Layout>
