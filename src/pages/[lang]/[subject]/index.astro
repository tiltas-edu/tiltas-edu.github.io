---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Icon from '../../../components/Icon.astro';
import { languages, t, type Lang, base } from '../../../i18n/ui';
import { subjects, groupKey, type Subject } from '../../../lib/subjects';
import { visual } from '../../../i18n/visual';

export function getStaticPaths() {
  return Object.keys(languages).flatMap((lang) => Object.keys(subjects).map((subject) => ({ params: { lang, subject } })));
}
const lang = Astro.params.lang as Lang;
const subject = Astro.params.subject as Subject;
const tr = t(lang);
const glossary = (await getCollection('glossary')).filter((g) => g.data.subject === subject);
const tasks = (await getCollection('tasks'))
  .filter((x) => x.data.subject === subject)
  .sort((a, b) => a.data.level - b.data.level || a.id.localeCompare(b.id));
const v = visual[lang];
// Visual reference pages, maths only for now.
const pictures = subject === 'math'
  ? [
      { href: 'column', title: v.columnTitle, lead: v.columnLead },
      { href: 'formulas', title: v.formulasTitle, lead: v.formulasLead },
      { href: 'times-table', title: v.timesTitle, lead: v.timesLead },
      { href: 'units', title: v.unitsTitle, lead: v.unitsLead },
      { href: 'fractions', title: v.fractionsTitle, lead: v.fractionsLead },
    ]
  : [];
const groups = subjects[subject]
  .map((id) => ({ id, title: tr[groupKey(id) as keyof typeof tr] ?? id, tasks: tasks.filter((x) => x.data.group === id) }))
  .filter((g) => g.tasks.length);
---
<Layout lang={lang} title={tr[subject]}>
  <h1><Icon name={subject} /> {tr[subject]}</h1>

  {pictures.length > 0 && (
    <>
      <h2>{v.section}</h2>
      <p>{v.sectionLead}</p>
      <div class="grid">
        {pictures.map((x) => (
          <a class="card" href={`${base}/${lang}/math/${x.href}/`}>
            <strong>{x.title}</strong>
            <div class="note">{x.lead}</div>
          </a>
        ))}
      </div>
    </>
  )}

  <h2>{tr.glossary}</h2>
  <div class="grid">
    {glossary.map((g) => (
      <a class="card" href={`${base}/${lang}/glossary/${g.id}/`}>
        <strong>{g.data.title[lang]}</strong>
        <div class="note">{g.data.terms.length} · {tr.flashcards.toLowerCase()}</div>
      </a>
    ))}
  </div>

  <h2>{tr.tasks}</h2>
  <p><a href={`${base}/${lang}/review/`}><Icon name="bulb" /> {tr.myMistakes}</a></p>
  {groups.map((g) => (
    <>
      <div class="group-head">
        <h3>{g.title}</h3>
        <span class="meter" data-meter={g.id} hidden>
          <span class="meter__bar"><span class="meter__fill"></span></span>
          <span class="meter__txt"></span>
        </span>
      </div>
      <div class="grid">
        {g.tasks.map((x, i) => (
          <a class="card" href={`${base}/${lang}/tasks/${x.id}/`} data-task={x.id} data-group={x.data.group}>
            <strong>{tr.task} {i + 1}</strong>
            <span class="badge badge--done" data-solved hidden><Icon name="check" /> {tr.solved}</span>
            <span class="badge badge--review" data-review hidden><Icon name="bulb" /> {tr.review}</span>
            <span class="badge badge--recheck" data-recheck hidden><Icon name="check" /> {tr.recheck}</span>
            <div class="note">{x.data.grade} {tr.grade} · {tr.level} {x.data.level}</div>
            <div lang="lt">{x.data.lt.slice(0, 90)}…</div>
          </a>
        ))}
      </div>
    </>
  ))}
  <span data-of={tr.progressOf} hidden></span>
  <script>
    import { count, loadAll } from '../../../lib/progress';

    // Marks each task by its state in this browser (set by TaskCheck) and fills the "3 of 6" meter of each group.
    const cards = [...document.querySelectorAll<HTMLElement>('[data-task]')];
    const items = cards.map((c) => ({ id: c.dataset.task!, subject: '', group: c.dataset.group! }));
    const logs = loadAll(items.map((x) => x.id));
    for (const c of cards) {
      const st = logs[c.dataset.task!]?.state;
      for (const k of ['solved', 'review', 'recheck']) c.querySelector<HTMLElement>(`[data-${k}]`)!.hidden = st !== k;
    }
    const of = document.querySelector<HTMLElement>('[data-of]')!.dataset.of!;
    const byGroup = count(items, logs, 'group');
    // Shown once something in the subject was tried, so a first visit stays clean.
    const tried = byGroup.all.solved + byGroup.all.review + byGroup.all.recheck > 0;
    document.querySelectorAll<HTMLElement>('[data-meter]').forEach((m) => {
      const c = byGroup[m.dataset.meter!];
      if (!c || !tried) return;
      m.querySelector<HTMLElement>('.meter__fill')!.style.width = `${(100 * c.solved) / c.total}%`;
      m.querySelector('.meter__txt')!.textContent = of.replace('{n}', String(c.solved)).replace('{total}', String(c.total));
      m.hidden = false;
    });
  </script>
</Layout>
