---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { topWords } from '../../lib/frequency';
import { languages, t, type Lang, base } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const ready = ['math', 'lithuanian', 'society'] as const;
const soon = [
  { id: 'nature', name: tr.nature },
  { id: 'physics', name: tr.physics },
] as const;
---
<Layout lang={lang}>
  <h1>Tiltas</h1>
  <p class="lead"><strong>{tr.tagline}</strong></p>
  <section class="hero">
    <h2>{tr.topWords}</h2>
    <p>{tr.topWordsLead}</p>
    {topWords.length > 0 && (
      <p class="hero__words" lang="lt">{topWords.map((w) => <span>{w.lemma}</span>)}</p>
    )}
    <a class="btn" href={`${base}/${lang}/words/`}><Icon name="book" /> {tr.startLearning}</a>
  </section>

  <h2>{tr.subjects}</h2>
  <div class="grid">
    {ready.map((id) => (
      <a class={`card tile tile--${id}`} href={`${base}/${lang}/${id}/`}>
        <span class="tile__icon"><Icon name={id} /></span>
        <h3>{tr[id]}</h3>
      </a>
    ))}
    {soon.map(({ id, name }) => (
      <div class={`card tile tile--${id} card--soon`}>
        <span class="tile__icon"><Icon name={id} /></span>
        <h3>{name} <span class="badge">{tr.soon}</span></h3>
      </div>
    ))}
  </div>

  <h2>{tr.myMistakes}</h2>
  <p>{tr.reviewLead}</p>
  <a class="btn" href={`${base}/${lang}/review/`}><Icon name="bulb" /> {tr.myMistakes}</a>
</Layout>
