---
import Layout from '../../../../layouts/Layout.astro';
import UnitLadder from '../../../../components/UnitLadder';
import NativeToggle from '../../../../components/NativeToggle.astro';
import { languages, t, type Lang, base } from '../../../../i18n/ui';
import { visual } from '../../../../i18n/visual';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const v = visual[lang];
---
<Layout lang={lang} title={v.unitsTitle} description={v.unitsLead}>
  <p><a href={`${base}/${lang}/math/`}>← {tr.math}</a></p>
  <h1>{v.unitsTitle}</h1>
  <p>{v.unitsLead}</p>
  <NativeToggle hide={v.hideTr} show={v.showTr} />
  <UnitLadder client:load labels={v} lang={lang} />
</Layout>
