---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Icon from '../../../components/Icon.astro';
import { languages, t, type Lang, base } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const glossary = (await getCollection('glossary')).filter((g) => g.data.subject === 'math');
const tasks = (await getCollection('tasks')).filter((x) => x.data.subject === 'math');
---
<Layout lang={lang} title={tr.math}>
  <h1><Icon name="math" /> {tr.math}</h1>

  <h2>{tr.glossary}</h2>
  <div class="grid">
    {glossary.map((g) => (
      <a class="card" href={`${base}/${lang}/glossary/${g.id}/`}>
        <strong>{g.data.title[lang]}</strong>
        <div class="note">{g.data.terms.length} · {tr.flashcards.toLowerCase()}</div>
      </a>
    ))}
  </div>

  <h2>{tr.tasks}</h2>
  <div class="grid">
    {tasks.map((x, i) => (
      <a class="card" href={`${base}/${lang}/tasks/${x.id}/`}>
        <strong>{tr.task} {i + 1}</strong>
        <div class="note">{x.data.grade} {tr.grade}</div>
        <div>{x.data.translation[lang].slice(0, 90)}…</div>
      </a>
    ))}
  </div>
</Layout>
