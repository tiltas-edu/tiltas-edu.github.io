---
import Layout from '../../../../layouts/Layout.astro';
import Bi from '../../../../components/Bi';
import NativeToggle from '../../../../components/NativeToggle.astro';
import { languages, t, type Lang, base } from '../../../../i18n/ui';
import { visual, visualLt as L } from '../../../../i18n/visual';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const v = visual[lang];
// The pictures use one cell = 1 cm, so the child can count: 5 by 3 cells.
const A = 5, B = 3, Q = 4, CELL = 24, PAD = 34, LEFT = 30;
// Speed units as each language writes them: Lithuanian km/val. and val., Russian км/ч and ч, English km/h and h.
const UNITS = {
  lt: { km: 'km', m: 'm', kmh: 'km/val.', ms: 'm/s', h: 'val.', min: 'min', s: 's' },
  ru: { km: 'км', m: 'м', kmh: 'км/ч', ms: 'м/с', h: 'ч', min: 'мин', s: 'с' },
  en: { km: 'km', m: 'm', kmh: 'km/h', ms: 'm/s', h: 'h', min: 'min', s: 's' },
};
type U = (typeof UNITS)['lt'];
const speed = {
  s: (u: U) => `${u.km}, ${u.m}`,
  v: (u: U) => `${u.kmh}, ${u.ms}`,
  t: (u: U) => `${u.h}, ${u.min}, ${u.s}`,
  sF: (u: U) => `${u.km} = ${u.kmh} · ${u.h}`,
  sE: (u: U) => `60 ${u.kmh} · 3 ${u.h} = 180 ${u.km}`,
  vF: (u: U) => `${u.kmh} = ${u.km} : ${u.h}`,
  vE: (u: U) => `180 ${u.km} : 3 ${u.h} = 60 ${u.kmh}`,
  tF: (u: U) => `${u.h} = ${u.km} : ${u.kmh}`,
  tE: (u: U) => `180 ${u.km} : 60 ${u.kmh} = 3 ${u.h}`,
  mF: (u: U) => `${u.m} = ${u.ms} · ${u.s}`,
  mE: (u: U) => `4 ${u.ms} · 25 ${u.s} = 100 ${u.m}`,
  all: (u: U) => `s = 60 ${u.kmh} · 3 ${u.h} = 180 ${u.km}; v = 180 ${u.km} : 3 ${u.h} = 60 ${u.kmh}; t = 180 ${u.km} : 60 ${u.kmh} = 3 ${u.h}`,
};
type K = keyof typeof speed;
// The Lithuanian form first; the reader's own form only where it is written differently.
const lt = (k: K) => speed[k](UNITS.lt);
const nat = (k: K) => (speed[k](UNITS[lang]) === lt(k) ? '' : speed[k](UNITS[lang]));
const words: [string, string, string, K][] = [
  ['s', 'atstumas, nueitas kelias', v.speedS, 's'], ['v', 'greitis', v.speedV, 'v'], ['t', 'laikas', v.speedT, 't'],
];
const rows: [string, K, K][] = [['s = v · t', 'sF', 'sE'], ['v = s : t', 'vF', 'vE'], ['t = s : v', 'tF', 'tE']];
---
<Layout lang={lang} title={v.formulasTitle} description={v.formulasLead}>
  <p><a href={`${base}/${lang}/math/`}>← {tr.math}</a></p>
  <h1>{v.formulasTitle}</h1>
  <p>{v.formulasLead}</p>
  <NativeToggle hide={v.hideTr} show={v.showTr} />

  <section class="fx">
    <h2><Bi lt={L.rectangle} native={v.rectangle} /></h2>
    <div class="fx__row">
      <svg class="fx__fig" viewBox={`0 0 ${A * CELL + 2 * PAD + LEFT} ${B * CELL + 2 * PAD}`} role="img" aria-label={`${v.rectangle}: a = ${A} cm, b = ${B} cm`}>
        <g transform={`translate(${PAD + LEFT} ${PAD / 2})`}>
          {Array.from({ length: A * B }, (_, i) => (
            <rect class="fx__cell" x={(i % A) * CELL} y={Math.floor(i / A) * CELL} width={CELL} height={CELL} />
          ))}
          <rect class="fx__edge" x="0" y="0" width={A * CELL} height={B * CELL} />
          <text class="fx__label" x={(A * CELL) / 2} y={B * CELL + 24} text-anchor="middle">a = {A} cm</text>
          <text class="fx__label" x={-8} y={(B * CELL) / 2 + 6} text-anchor="end">b = {B}</text>
        </g>
      </svg>
      <div class="fx__list">
        <p><strong>a</strong> — <span lang="lt">ilgis</span> <span class="native">({v.length})</span></p>
        <p><strong>b</strong> — <span lang="lt">plotis</span> <span class="native">({v.width})</span></p>
        <p class="fx__f">S = a · b</p>
        <p>S — <span lang="lt">plotas</span> <span class="native">({v.area})</span></p>
        <Bi as="p" lt={L.areaHow} native={v.areaHow} />
        <p class="fx__f">P = (a + b) · 2</p>
        <p>P — <span lang="lt">perimetras</span> <span class="native">({v.perimeter})</span></p>
        <Bi as="p" lt={L.perimeterHow} native={v.perimeterHow} />
      </div>
    </div>
    <div class="callout callout--hint">
      <p><strong><span lang="lt">{L.example}</span><span class="native"> ({v.example})</span>:</strong> a = {A} cm, b = {B} cm → S = {A} · {B} = {A * B} cm², P = ({A} + {B}) · 2 = {(A + B) * 2} cm.</p>
      <Bi as="p" lt={L.findWidth} native={v.findWidth} />
      <p><strong class="fx__f">b = P : 2 − a</strong> ({(A + B) * 2} : 2 − {A} = {B} cm)</p>
      <Bi as="p" lt={L.findFromArea} native={v.findFromArea} />
      <p><strong class="fx__f">b = S : a</strong> ({A * B} : {A} = {B} cm)</p>
    </div>
  </section>

  <section class="fx">
    <h2><Bi lt={L.square} native={v.square} /></h2>
    <div class="fx__row">
      <svg class="fx__fig" viewBox={`0 0 ${Q * CELL + 2 * PAD + LEFT} ${Q * CELL + 2 * PAD}`} role="img" aria-label={`${v.square}: a = ${Q} cm`}>
        <g transform={`translate(${PAD + LEFT} ${PAD / 2})`}>
          {Array.from({ length: Q * Q }, (_, i) => (
            <rect class="fx__cell" x={(i % Q) * CELL} y={Math.floor(i / Q) * CELL} width={CELL} height={CELL} />
          ))}
          <rect class="fx__edge" x="0" y="0" width={Q * CELL} height={Q * CELL} />
          <text class="fx__label" x={(Q * CELL) / 2} y={Q * CELL + 24} text-anchor="middle">a = {Q} cm</text>
          <text class="fx__label" x={-8} y={(Q * CELL) / 2 + 6} text-anchor="end">a</text>
        </g>
      </svg>
      <div class="fx__list">
        <p><strong>a</strong> — <span lang="lt">kraštinė</span> <span class="native">({v.side})</span></p>
        <p class="fx__f">S = a · a</p>
        <p class="fx__f">P = a · 4</p>
        <Bi as="p" lt={L.findSide} native={v.findSide} />
        <p><strong class="fx__f">a = P : 4</strong></p>
      </div>
    </div>
    <div class="callout callout--hint">
      <p><strong><span lang="lt">{L.example}</span><span class="native"> ({v.example})</span>:</strong> a = {Q} cm → S = {Q} · {Q} = {Q * Q} cm², P = {Q} · 4 = {Q * 4} cm.</p>
      <Bi as="p" lt={L.cells} native={v.cells} />
    </div>
  </section>

  <section class="fx">
    <h2><Bi lt={L.speed} native={v.speed} /></h2>
    <div class="fx__row">
      <svg class="fx__fig fx__fig--tri" viewBox="0 0 200 170" role="img" aria-label="s = v · t">
        <path class="fx__tri" d="M100 10 L190 160 L10 160 Z" />
        <path class="fx__tri-line" d="M45 100 H155 M100 100 V160" />
        <text class="fx__big" x="100" y="78" text-anchor="middle">s</text>
        <text class="fx__big" x="68" y="146" text-anchor="middle">v</text>
        <text class="fx__big" x="132" y="146" text-anchor="middle">t</text>
      </svg>
      <div class="fx__list">
        {words.map(([x, word, tr, k]) => (
          <p>
            <strong>{x}</strong> — <span lang="lt">{word}</span> <span class="native">({tr})</span>{' '}
            <span class="fx__u" lang="lt">{lt(k)}</span>
            {nat(k) && <span class="fx__u fx__u--native native">{nat(k)}</span>}
          </p>
        ))}
        {rows.map(([f, k, e]) => (
          <p>
            <span class="fx__f">{f}</span>{' '}
            <span class="fx__u" lang="lt">{lt(k)}</span>
            {nat(k) && <span class="fx__u fx__u--native native">{nat(k)}</span>}
            <span class="fx__eg"><span lang="lt">{lt(e)}</span>{nat(e) && <span class="fx__eg-native native">{nat(e)}</span>}</span>
          </p>
        ))}
        <p class="note">
          m/s: <span class="fx__u" lang="lt">{lt('mF')}</span>
          {nat('mF') && <span class="fx__u fx__u--native native">{nat('mF')}</span>}
          <span class="fx__eg"><span lang="lt">{lt('mE')}</span>{nat('mE') && <span class="fx__eg-native native">{nat('mE')}</span>}</span>
        </p>
      </div>
    </div>
    <div class="callout callout--hint">
      <Bi as="p" lt={L.triangle} native={v.triangle} />
      <p><strong><span lang="lt">{L.example}</span><span class="native"> ({v.example})</span>:</strong></p>
      <Bi as="p" lt={L.speedExample} native={v.speedExample} />
      <Bi as="p" lt={lt('all')} native={nat('all') || lt('all')} />
      <Bi as="p" lt={L.units} native={v.units} />
    </div>
  </section>
</Layout>
