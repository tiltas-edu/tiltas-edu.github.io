---
import Layout from '../../../../layouts/Layout.astro';
import TimesTable from '../../../../components/TimesTable';
import NativeToggle from '../../../../components/NativeToggle.astro';
import { languages, t, type Lang, base } from '../../../../i18n/ui';
import { visual } from '../../../../i18n/visual';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const v = visual[lang];
---
<Layout lang={lang} title={v.timesTitle} description={v.timesLead} wide>
  <p><a href={`${base}/${lang}/math/`}>← {tr.math}</a></p>
  <div class="page-head">
    <h1>{v.timesTitle} <small class="note" lang="lt">({v.timesTable})</small></h1>
    <NativeToggle hide={v.hideTr} show={v.showTr} />
  </div>
  <p>{v.timesLead}</p>
  <TimesTable client:load labels={v} lang={lang} />
</Layout>
