---
import Layout from '../../../layouts/Layout.astro';
import TaskCheck from '../../../components/TaskCheck';
import { getCollection } from 'astro:content';
import { languages, t, type Lang, base } from '../../../i18n/ui';

export async function getStaticPaths() {
  const tasks = await getCollection('tasks');
  return Object.keys(languages).flatMap((lang) =>
    tasks.map((x) => ({ params: { lang, id: x.id }, props: { entry: x } })),
  );
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const { entry } = Astro.props;
const d = entry.data;

// Terms of the task's topic first, then the general task-wording terms.
const glossaries = (await getCollection('glossary'))
  .filter((g) => g.id === d.topic || g.id === 'task-wording')
  .sort((a, b) => Number(b.id === d.topic) - Number(a.id === d.topic));

const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
const rx = d.keywords.length
  ? new RegExp(`(${d.keywords.map((k) => k.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'gi')
  : null;
const ltHtml = rx ? esc(d.lt).replace(rx, '<mark>$1</mark>') : esc(d.lt);

// Glossary terms whose every word (minus its ending) starts a word of the task text.
// Short words must match whole, so "kiek" does not match "kiekvienas". Nasal letters are folded,
// so "plotas" finds "plotą". Only the part before " / " and outside "( )" is matched.
const fold = (s: string) => s.toLowerCase().replace(/[ąęįų]/g, (c) => ({ ą: 'a', ę: 'e', į: 'i', ų: 'u' })[c]!);
const stem = (w: string) => w.slice(0, w.length >= 7 ? w.length - 2 : w.length >= 5 ? w.length - 1 : w.length);
const taskWords = fold(d.lt).match(/[\p{L}\p{M}]+/gu) ?? [];
const has = (word: string) => taskWords.some((w) => (word.length < 5 ? w === word : w.startsWith(stem(word))));
const seen = new Set<string>();
const words = glossaries.flatMap((g) => g.data.terms).filter((term) => {
  const parts = fold(term.lt.split(' / ')[0].replace(/\(.*?\)/g, '')).match(/[\p{L}\p{M}]+/gu) ?? [];
  if (!parts.length || !parts.every(has) || seen.has(term.lt)) return false;
  seen.add(term.lt);
  return true;
});
const unit = d.answer.replace(/^[\d\s.,]+/, '');
---
<Layout lang={lang} title={`${tr.task}: ${d.lt.slice(0, 50)}`}>
  <p><a href={`${base}/${lang}/math/`}>← {tr.math}</a></p>
  <h1>{tr.task}</h1>

  <p class="task-lt" lang="lt" set:html={ltHtml} />

  <!-- Closed by default: first try to read the Lithuanian text, then check with the translation. -->
  <details class="reveal">
    <summary>{tr.showTranslation}</summary>
    <p class="task-tr">{d.translation[lang]}</p>
  </details>

  {words.length > 0 && (
    <>
      <h2>{tr.words}</h2>
      <table class="terms">
        <tbody>
          {words.map((w) => (<tr><td><strong>{w.lt}</strong></td><td>{w[lang]}</td></tr>))}
        </tbody>
      </table>
    </>
  )}

  <h2>{tr.yourAnswer}</h2>
  <TaskCheck client:load taskId={entry.id} accepted={d.check} unit={unit}
    mistakes={d.mistakes.map((m) => ({ value: m.value, hint: m.hint[lang] }))}
    labels={{ yourAnswer: tr.yourAnswer, check: tr.check, correct: tr.correct, wrong: tr.wrong, tryAgain: tr.tryAgain }} />

  <details class="reveal">
    <summary><strong>{tr.showSolution}</strong></summary>
    <h2>{tr.solution}</h2>
    <ol class="steps">
      {d.steps[lang].map((s) => <li>{s}</li>)}
    </ol>
    <p class="answer">{tr.answer}: {d.answer}</p>
  </details>
</Layout>
