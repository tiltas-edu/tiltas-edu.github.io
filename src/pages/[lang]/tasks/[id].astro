---
import Layout from '../../../layouts/Layout.astro';
import TaskCheck from '../../../components/TaskCheck';
import Hints from '../../../components/Hints';
import { visual } from '../../../i18n/visual';
import type { Scheme } from '../../../lib/scheme';
import { getCollection } from 'astro:content';
import { languages, t, type Lang, base } from '../../../i18n/ui';
import type { Subject } from '../../../lib/subjects';
import { frequency } from '../../../lib/frequency';
import { wordsInText } from '../../../lib/pos';

export async function getStaticPaths() {
  const tasks = await getCollection('tasks');
  return Object.keys(languages).flatMap((lang) =>
    tasks.map((x) => ({ params: { lang, id: x.id }, props: { entry: x } })),
  );
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const { entry } = Astro.props;
const d = entry.data;

// Terms of the task's topic first, then the general ones: task wording and the small words.
const general = ['task-wording', 'small-words'];
const glossaries = (await getCollection('glossary'))
  .filter((g) => g.id === d.topic || general.includes(g.id))
  .sort((a, b) => Number(b.id === d.topic) - Number(a.id === d.topic));

const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
const rx = d.keywords.length
  ? new RegExp(`(${d.keywords.map((k) => k.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'gi')
  : null;
const ltHtml = rx ? esc(d.lt).replace(rx, '<mark>$1</mark>') : esc(d.lt);

// Glossary terms whose every word (minus its ending) starts a word of the task text.
// Short words must match whole, so "kiek" does not match "kiekvienas". Nasal letters are folded,
// so "plotas" finds "plotą". Only the part before " / " and outside "( )" is matched.
const fold = (s: string) => s.toLowerCase().replace(/[ąęįų]/g, (c) => ({ ą: 'a', ę: 'e', į: 'i', ų: 'u' })[c]!);
const stem = (w: string) => w.slice(0, w.length >= 7 ? w.length - 2 : w.length >= 5 ? w.length - 1 : w.length);
const taskWords = fold(d.lt).match(/[\p{L}\p{M}]+/gu) ?? [];
const has = (word: string) => taskWords.some((w) => (word.length < 5 ? w === word : w.startsWith(stem(word))));
const seen = new Set<string>();
const words = glossaries.flatMap((g) => g.data.terms).filter((term) => {
  const parts = fold(term.lt.split(' / ')[0].replace(/\(.*?\)/g, '')).match(/[\p{L}\p{M}]+/gu) ?? [];
  if (!parts.length || !parts.every(has) || seen.has(term.lt)) return false;
  seen.add(term.lt);
  return true;
});
// Words of real textbook tasks met in this text that no glossary row above explains, most frequent first.
const explained = new Set(words.flatMap((w) => w.lt.toLowerCase().match(/[\p{L}\p{M}]+/gu) ?? []));
const often = wordsInText(frequency.words, d.lt, explained).slice(0, 8);
// The form as written in this task, when it is not the dictionary form: "būti (yra)".
const ltLower = new Set(d.lt.toLowerCase().match(/[\p{L}\p{M}]+/gu) ?? []);
const asWritten = (w: { lemma: string; forms: string[] }) => w.forms.find((f) => ltLower.has(f.toLowerCase()) && f.toLowerCase() !== w.lemma.toLowerCase());
// A unit only for typed numeric answers: "2 500 m²" → "m²".
// Visual maths pages that show the idea behind this task.
const v = visual[lang];
const pages = {
  column: [v.columnTitle, v.columnLead], formulas: [v.formulasTitle, v.formulasLead], 'times-table': [v.timesTitle, v.timesLead],
  units: [v.unitsTitle, v.unitsLead], fractions: [v.fractionsTitle, v.fractionsLead],
} as const;
const see = d.see.map((href) => ({ href, title: pages[href][0], lead: pages[href][1] }));
const unit = d.choices || !/^\d/.test(d.answer) ? undefined : d.answer.replace(/^[\d\s.,]+/, '') || undefined;
---
<Layout lang={lang} title={`${tr.task}: ${d.lt.slice(0, 50)}`}>
  <p><a href={`${base}/${lang}/${d.subject}/`}>← {tr[d.subject as Subject]}</a></p>
  <h1>{tr.task}</h1>

  <p class="task-lt" lang="lt" set:html={ltHtml} />

  <!-- Closed by default: first try to read the Lithuanian text, then check with the translation. -->
  <details class="reveal">
    <summary>{tr.showTranslation}</summary>
    <p class="task-tr">{d.translation[lang]}</p>
  </details>

  {words.length > 0 && (
    <>
      <h2>{tr.words}</h2>
      <table class="terms">
        <tbody>
          {words.map((w) => (<tr><td><strong>{w.lt}</strong></td><td>{w[lang]}</td></tr>))}
        </tbody>
      </table>
    </>
  )}

  {often.length > 0 && (
    <>
      <h2>{tr.oftenWords}</h2>
      <p class="note">{tr.oftenWordsLead} <a href={`${base}/${lang}/words/`}>{tr.topWords}</a></p>
      <table class="terms">
        <tbody>
          {often.map((w) => (
            <tr><td><strong lang="lt">{w.lemma}</strong>{asWritten(w) && <span class="note" lang="lt"> ({asWritten(w)})</span>}</td><td>{w[lang]}</td><td class="note nowrap">{tr.inTasks.replace('{count}', String(w.tasks)).replace('{total}', String(frequency.tasks))}</td></tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  <h2>{tr.yourAnswer}</h2>
  <TaskCheck client:load taskId={entry.id} accepted={d.check} unit={unit} choices={d.choices}
    mistakes={d.mistakes.map((m) => ({ value: m.value, hint: m.hint[lang] }))}
    labels={{ yourAnswer: tr.yourAnswer, check: tr.check, correct: tr.correct, wrong: tr.wrong, tryAgain: tr.tryAgain, recheckNote: tr.recheckNote, fixed: tr.fixed }} />

  <Hints client:load taskId={entry.id} lang={lang} scheme={d.scheme as Scheme | undefined} steps={d.steps[lang]} answer={d.answer}
    labels={{ hint: tr.hint, hintOf: tr.hintOf, scheme: tr.scheme, firstStep: tr.firstStep, solution: tr.solution, showSolution: tr.showSolution, answer: tr.answer }} />

  {see.length > 0 && (
    <>
      <h2>{tr.seeIt}</h2>
      <div class="grid">
        {see.map((x) => (
          <a class="card" href={`${base}/${lang}/math/${x.href}/`}>
            <strong>{x.title}</strong>
            <div class="note">{x.lead}</div>
          </a>
        ))}
      </div>
    </>
  )}
</Layout>
