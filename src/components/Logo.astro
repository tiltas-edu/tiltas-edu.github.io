---
interface Props { href: string }
const { href } = Astro.props;
---
<a class="logo" href={href} aria-label="Tiltas">
  <svg viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="16" fill="var(--c-brand)" />
    <path d="M9 42h46" stroke="#fff" stroke-width="5" stroke-linecap="round" />
    <path d="M14 42V33a18 18 0 0 1 36 0v9" stroke="#fff" stroke-width="5" stroke-linecap="round" fill="none" />
    <path d="M25 42V34M32 42V28M39 42V34" stroke="var(--c-accent)" stroke-width="4" stroke-linecap="round" />
  </svg>
  <span>Til<b>tas</b></span>
</a>
