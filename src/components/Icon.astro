---
import { icons, type IconName } from './icons';
interface Props { name: IconName; label?: string }
const { name, label } = Astro.props;
---
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} set:html={icons[name]} />
